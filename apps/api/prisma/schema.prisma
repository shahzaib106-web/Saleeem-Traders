generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique name String? role String @default("customer") createdAt DateTime @default(now()) }
model Product { id String @id @default(cuid()) name String slug String @unique price Int stock Int @default(0) createdAt DateTime @default(now()) }
