{
  "name": "saleeem-traders",
  "private": true,
  "version": "0.1.0",
  "description": "Saleem Traders commerce platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/storefront",
    "build": "npm run build --workspace=apps/storefront",
    "start": "npm run start --workspace=apps/storefront",
    "lint": "npm run lint --workspace=apps/storefront",
    "typecheck": "npm run typecheck --workspace=apps/storefront",
    "dev:storefront": "npm run dev --workspace=apps/storefront",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:api": "npm run start:dev --workspace=apps/api"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^10.11.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module"
}
